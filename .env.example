# Use the same Supabase project as the web deployment that drivers open.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Required for shareable invites from native Android builds. On the deployed
# website, the browser's public HTTPS origin is used if this is omitted.
# A development build needs its own deployed URL using the DEV database.
VITE_PUBLIC_APP_URL=https://kisan-go.vercel.app
